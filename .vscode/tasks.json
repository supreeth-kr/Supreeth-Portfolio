{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Portfolio Server",
            "type": "shell",
            "command": "node serve.js",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Server running at http://localhost:3000/"
                }
            }
        }
    ]
}
